# Copy to .env and set what you need. The server reads these from the environment.
# Example: PORT=3000 ADMIN_TOKEN=... node server.js

PORT=3000
NODE_ENV=production

# Moderator login. Leave empty to turn moderation off. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Sites allowed to open a live connection, comma separated. Empty means only the site itself.
ALLOWED_ORIGINS=

# Set to true when the site is served over https. It turns on HSTS and upgrades any http request.
# Leave it off for testing on http://localhost.
HTTPS_ONLY=false

# Set to true only when the app runs behind a reverse proxy (Nginx, Caddy, Render, Railway...).
# It makes the server read the visitor's address from X-Forwarded-For.
TRUST_PROXY=false

# One vote per network address instead of per browser tab. Default is true in production.
ONE_VOTE_PER_IP=

# Turn timings in seconds
READY_SECONDS=3
PERFORM_SECONDS=60
VOTE_SECONDS=10
RESULT_SECONDS=6

MAX_QUEUE=30
MAX_CONNECTIONS_PER_IP=8
MAX_CONNECTIONS=400
# How many people can hear the rapper at once (peer to peer limit)
MAX_AUDIO_LISTENERS=25

# Voice relay for people behind strict networks (optional, recommended for a public launch)
TURN_URL=
TURN_USER=
TURN_PASS=

DATA_DIR=./data
